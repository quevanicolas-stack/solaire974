# ==================================================================
# Fluent & Forward — en-têtes de sécurité (Cloudflare Pages)
#
# Ce fichier se dépose tel quel à la racine du site. Cloudflare Pages
# le lit automatiquement et ajoute ces en-têtes à chaque réponse.
# Il ne s'affiche jamais aux visiteurs.
# ==================================================================

/*
  # Empêche d'autres sites d'afficher le nôtre dans un cadre invisible
  # pour piéger les clics des visiteurs.
  X-Frame-Options: DENY

  # Empêche le navigateur de « deviner » le type d'un fichier, ce qui
  # peut transformer un fichier anodin en script exécutable.
  X-Content-Type-Options: nosniff

  # Ne transmet pas l'adresse de nos pages aux sites externes visités
  # depuis le site (Calendly, WhatsApp, réseaux sociaux).
  Referrer-Policy: strict-origin-when-cross-origin

  # Coupe l'accès aux capteurs et périphériques : le site n'en a aucun
  # besoin, autant les refuser franchement.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()

  # Impose le HTTPS pendant deux ans, sous-domaines compris.
  # VOLONTAIREMENT DÉSACTIVÉ POUR L'INSTANT : retirer le # ci-dessous
  # UNIQUEMENT une fois le site réellement joignable en HTTPS (étape 7
  # du guide). Activée trop tôt, cette ligne rend le site injoignable
  # pendant deux ans, sans retour en arrière possible.
  # Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # Politique de contenu : liste ce que la page a le droit de charger.
  # Tout le reste est refusé par le navigateur, y compris un script
  # qu'un attaquant parviendrait à injecter.
  #   default-src 'self'      rien d'externe par défaut
  #   img-src ... data:       les visuels sont intégrés en data:URI
  #   style-src 'self'        les polices et les styles viennent du site
  #   font-src 'self'         les fichiers de police aussi
  #   connect-src ...         l'envoi des formulaires vers Google Apps Script
  #   frame-ancestors 'none'  personne ne peut nous encadrer
  #   form-action 'self'      un formulaire ne peut pas partir ailleurs
  #   frame-src ...           le cadre de vérification anti-robots Turnstile
  #
  # Depuis que les polices sont servies par le site, plus aucun domaine
  # extérieur n'intervient dans l'affichage d'une page. Restent deux
  # services de Cloudflare :
  #   challenges.cloudflare.com    la vérification anti-robots du formulaire
  #   static.cloudflareinsights.com le mouchard de Web Analytics, que
  #     Cloudflare injecte lui-même dans la page. Sans cette autorisation
  #     le navigateur le bloque en silence, et le tableau de bord des
  #     visites reste vide — c'était le cas jusqu'ici.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://challenges.cloudflare.com https://cloudflareinsights.com; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests

# Les polices ne changent jamais : on les garde en cache un an, ce qui
# évite de les retélécharger d'une page à l'autre et d'une visite à
# l'autre.
/assets/polices/*
  Cache-Control: public, max-age=31536000, immutable

# La page de capture du guide vit sous /guide/. Elle avait son propre
# fichier _headers quand elle était publiée séparément ; Cloudflare ne
# lit que celui de la racine, ses règles utiles sont donc reprises ici.

# L'écran de suivi des prospects est réservé à Aurélie : il ne doit
# apparaître dans aucun moteur de recherche.
/guide/prospects.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store

# La page de remerciement n'a de sens qu'après le formulaire : la
# référencer permettrait d'atteindre le guide sans laisser ses
# coordonnées.
/guide/stop-avoiding.html
  X-Robots-Tag: noindex, nofollow

# Le PDF lui-même ne doit pas être indexé : il se mérite par le
# formulaire, pas par une recherche.
/guide/assets/stop-avoiding-english-essentials.pdf
  X-Robots-Tag: noindex, nofollow
