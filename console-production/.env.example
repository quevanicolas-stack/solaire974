# Nom de marque utilisé dans toute l'application (signature du fond d'écran, titres, etc.)
NOM_MARQUE=À_DEFINIR

# Base de données SQLite
DATABASE_PATH=data/app.db

# Dossier racine des commandes (sources, extraits, variantes, livrables)
COMMANDES_DIR=commandes

# --- Ingestion depuis le site e-commerce (mode pull) ---
# URL de base du site (ex: https://boutique.example.com)
URL_SITE=
# Jeton porté dans l'en-tête Authorization: Bearer <JETON_SITE>
JETON_SITE=

# --- Extraction vidéo ---
# Nombre d'images extraites par défaut par vidéo
EXTRACTION_NB_IMAGES=40
# Seuil de netteté (variance du laplacien) en dessous duquel une image est écartée
EXTRACTION_SEUIL_NETTETE=100.0

# --- Génération ---
# Adaptateur de génération d'images utilisé :
#   factice      -> images de test, aucune dépendance, aucun calcul (par défaut)
#   local_texte  -> Stable Diffusion en local (texte seul), nécessite
#                   pip install -r requirements-generation-locale.txt
#                   et un premier lancement avec connexion internet pour
#                   télécharger le modèle une seule fois (~5 Go).
ADAPTATEUR_GENERATION=factice

# Modèle Hugging Face utilisé par l'adaptateur local_texte. Si le
# téléchargement échoue, vérifier l'identifiant actuel du dépôt sur
# huggingface.co (les dépôts de modèles peuvent être déplacés).
MODELE_GENERATION_LOCAL=sd-legacy/stable-diffusion-v1-5
